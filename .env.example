# Free key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Chat model. List the ones your key can use with:  python -m practicum_rag.cli models
# If you get "503 high demand" errors, switch to a lighter model such as gemini-3.5-flash-lite.
RAG_LLM_MODEL=gemini-3.5-flash
RAG_EMBED_MODEL=gemini-embedding-001

# Folders to index (comma-separated). data/private is git-ignored.
RAG_DATA_DIRS=data/sample,data/private

# Retrieval settings
RAG_CHUNK_SIZE=256
RAG_CHUNK_OVERLAP=32
RAG_TOP_K=3
RAG_MIN_SCORE=0

# Set to 1 to run with mock models (no API key, no network). Used by tests.
RAG_OFFLINE=0
